<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card Styles -->
    <style name="Widget.TurantPay.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">?colorSurface</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.TurantPay.Card.Elevated" parent="Widget.TurantPay.Card">
        <item name="cardElevation">4dp</item>
    </style>

    <style name="Widget.TurantPay.Card.Action" parent="Widget.TurantPay.Card">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.TurantPay.Button" parent="Widget.TurantPay.Button.Primary" />

    <style name="Widget.TurantPay.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:textSize">@dimen/text_lg</item>
    </style>

    <style name="Widget.TurantPay.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:textSize">@dimen/text_lg</item>
    </style>

    <style name="Widget.TurantPay.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:textSize">@dimen/text_lg</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.TurantPay.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_3xl</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
    </style>

    <style name="TextAppearance.TurantPay.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
    </style>

    <style name="TextAppearance.TurantPay.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.TurantPay.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.TurantPay.Amount" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
    </style>

    <style name="TextAppearance.TurantPay.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.TurantPay.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="background">?colorSurface</item>
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">@dimen/elevation_nav</item>
    </style>

    <!-- Input Styles -->
    <style name="Widget.TurantPay.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">?colorOnSurfaceVariant</item>
    </style>
</resources>
