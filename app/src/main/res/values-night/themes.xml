<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.TurantPay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary_medium</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/nav_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bottomNavigationStyle">@style/Widget.TurantPay.BottomNav</item>
        <item name="materialCardViewStyle">@style/Widget.TurantPay.Card</item>
    </style>

    <style name="Theme.TurantPay" parent="Base.Theme.TurantPay" />

    <style name="Theme.TurantPay.Splash" parent="Base.Theme.TurantPay">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
    </style>
</resources>